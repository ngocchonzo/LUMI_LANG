{
  "name": "lumilang-vscode",
  "displayName": "LumiLang",
  "description": "Write and run LumiLang programs from Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "lumilang-team",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:lumilang", "onCommand:lumilang.run"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lumilang",
        "aliases": ["LumiLang", "lumi"],
        "extensions": [".lumi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumilang",
        "scopeName": "source.lumilang",
        "path": "./syntaxes/lumi.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "lumilang.run", "title": "LumiLang: Run", "category": "LumiLang" }
    ],
    "menus": {
      "editor/title": [
        { "command": "lumilang.run", "when": "resourceLangId == lumilang", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4"
  }
}
